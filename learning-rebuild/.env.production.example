# =============================================================================
# ENV PRODUKSI — Platform Sekolah SMK Nagara (deployment Docker server lokal)
# -----------------------------------------------------------------------------
# 1. Salin file ini menjadi `.env.production`  (JANGAN commit .env.production).
# 2. GANTI semua nilai bertanda "GANTI!" — terutama password & secret.
# 3. Jalankan:
#    docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# =============================================================================

# ---- Database PostgreSQL (internal container, tidak diekspos ke LAN) ----
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=GANTI!_password_db_yang_kuat
POSTGRES_DB=lms_rebuild

# ---- Secret Aplikasi (WAJIB diganti dengan string acak panjang) ----
# Tips membuat: buka WSL/terminal → `openssl rand -hex 32`
JWT_SECRET=GANTI!_jwt_secret_acak_minimal_32_karakter
JWT_EXPIRATION=7d
QR_SECRET=GANTI!_qr_secret_acak_minimal_32_karakter

# ---- Jaringan / Akses ----
# Port HTTP yang dibuka di PC server (default 80). Ubah bila 80 dipakai.
HTTP_PORT=80
# Alamat dasar aplikasi (dipakai di tautan email verifikasi). Isi IP/hostname
# server di LAN, mis. http://192.168.1.10  atau http://lms.sekolah.lokal
APP_BASE_URL=http://192.168.1.10
# CORS: kosongkan bila web & API diakses satu-origin via Nginx (disarankan).
# Isi hanya bila ada klien lain (mis. aplikasi mobile) — daftar dipisah koma.
CORS_ORIGINS=
# Base URL API untuk web. Kosongkan agar web memakai '/api' relatif via Nginx.
NEXT_PUBLIC_API_URL=

# ---- Email / Notifikasi (opsional) ----
# Bila SMTP_HOST kosong → email hanya di-log (mode dev), tidak dikirim nyata.
MAIL_FROM=no-reply@smknagara.sch.id
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# =============================================================================
# CATATAN:
# - Storage berkas unggahan: volume Docker `lms_uploads_data` (disk lokal).
#   Tidak memakai MinIO/S3.
# - Sumber data ETL (MySQL learning/absen) TIDAK diperlukan saat runtime.
#   Variabel MYSQL_*/ABSEN_MYSQL_* hanya dipakai bila menjalankan skrip ETL
#   secara manual dari dalam WSL (lihat docs/05 & docs/08). Tidak dimuat compose.
# =============================================================================
