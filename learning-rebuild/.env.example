# Database Configuration
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password
POSTGRES_DB=lms_rebuild
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lms_user:lms_password@localhost:5432/lms_rebuild?schema=public

# Legacy MySQL Database (Source for ETL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=learning

# Legacy MySQL Database Absensi (Source for ETL rekonsiliasi absen)
# Bila kosong, fallback ke MYSQL_* di atas. Database default: absen
ABSEN_MYSQL_HOST=localhost
ABSEN_MYSQL_PORT=3306
ABSEN_MYSQL_USER=root
ABSEN_MYSQL_PASSWORD=
ABSEN_MYSQL_DATABASE=absen

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=lms-uploads

# Application Secrets
JWT_SECRET=super_secret_jwt_key_smk_nagara_2026_change_in_production
JWT_EXPIRATION=7d
PORT=4000

# QR Absensi (payload ter-tandatangan HMAC). Fallback ke JWT_SECRET bila kosong.
QR_SECRET=super_secret_qr_key_smk_nagara_2026_change_in_production

# Email / Notifikasi (Fase A5)
# Bila SMTP_HOST kosong → mode dev (email di-log, tidak dikirim nyata).
MAIL_FROM=no-reply@smknagara.sch.id
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
